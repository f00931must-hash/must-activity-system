rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isBuiltInAdmin() {
      return signedIn() && email() in ["master004400@gmail.com"];
    }

    function isListedAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/settings/admins)
        && email() in get(/databases/$(database)/documents/settings/admins).data.emails;
    }

    function isAdmin() {
      return isBuiltInAdmin() || isListedAdmin();
    }

    match /activities/{activityId} {
      allow read: if true;

      // 老師管理活動；學生報名/回饋時只會更新人數
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || true;

      match /registrations/{studentId} {
        allow create: if true;
        allow get: if true;
        allow list, update, delete: if isAdmin();
      }

      // 保險敏感資料與一般報名資料分開保存：學生只可建立，只有管理者可讀取/修改/刪除。
      match /insurance/{studentId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
      }

      match /feedbacks/{studentId} {
        allow create: if true;
        allow get: if true;
        allow list, update, delete: if isAdmin();
      }
    }


    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /settings/activityTags {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /settings/certificationRoster {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/certificationAttendance {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/admins {
      // 讓已登入老師可以讀取名單，才能判斷自己是否為管理者
      allow read: if signedIn();
      allow create, update: if isBuiltInAdmin() || isListedAdmin();
      allow delete: if false;
    }
  }
}
